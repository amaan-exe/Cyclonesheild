# ============================================================
# Cyclone Shield AI — Environment Configuration
# ============================================================

# --- Server Configuration ---
PORT=8000
HOST=0.0.0.0

# --- Database Configuration ---
# Option A: Universal Cloud Connection String (Recommended for Supabase, Neon, Render, Railway)
# DATABASE_URL=postgresql://username:password@hostname:5432/databasename?sslmode=require

# Option B: Individual Connection Parameters
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=postgres
DB_USER=cyclone_app
DB_PASS=cyclone_secure_pass
DB_SSLMODE=prefer

# --- Authentication & Security ---
# Generate a strong 32+ character random secret for production JWT signing
JWT_SECRET=cyclone_horizon_sih2026_super_secret_key_987654321

# --- AI Assistant (Optional) ---
# Groq Cloud API Key for the LLaMA-3 Emergency Cyclone Assistant Chatbot
GROQ_API_KEY=

# --- MOSDAC & Live Telemetry (Optional) ---
# If credentials are not provided, the platform automatically utilizes
# real-time open marine sensor feeds (Open-Meteo) & synoptic simulations.
MOSDAC_USERNAME=
MOSDAC_PASSWORD=
MOSDAC_API_TOKEN=
MOSDAC_API_URL=
MOSDAC_LIVE_MODE=true
MOSDAC_TIMEOUT_SECONDS=30

# Default Synoptic Feed & Basin Storm
DEFAULT_FEED_SOURCE=live_nio_surveillance
ACTIVE_CYCLONE_NAME=Cyclone Shakti
